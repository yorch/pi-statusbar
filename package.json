{
  "name": "@yorch/pi-statusbar",
  "version": "0.4.1",
  "description": "Theme-aware status bar (footer) for the pi coding agent \u2014 modular segments, presets, rich git status, context progress bar, session clock, Nerd Font icons.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22 || 24 || 26"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "status-bar",
    "footer",
    "extension",
    "statusline"
  ],
  "license": "MIT",
  "author": "Jorge Barnaby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorch/pi-statusbar.git"
  },
  "bugs": {
    "url": "https://github.com/yorch/pi-statusbar/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "bun run verify && node scripts/check-packables.mjs && changeset publish"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "22.15.32",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/yorch/pi-statusbar/main/assets/statusbar-preview.png"
  }
}
